{
  "expo": {
    "name": "FarmFreshFarmer",
    "slug": "farmfreshfarmer",
    "version": "5.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#14532d"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.farmfreshfarmer.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FarmFreshFarmer uses your location to calculate delivery fees and estimated arrival times."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14532d"
      },
      "package": "com.farmfreshfarmer.app",
      "versionCode": 19,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "farmfreshfarmer",
              "host": "oauthredirect"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-location"
    ],
    "scheme": "farmfreshfarmer",
    "experiments": {
      "typedRoutes": true
    }
  }
}
